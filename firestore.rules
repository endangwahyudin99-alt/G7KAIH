rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /school_profile/{profileId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /classes/{classId} {
      allow read, write: if true;
    }

    match /journals/{journalId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

